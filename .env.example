# Copy to .env and adjust as needed. Never commit .env.
SWO_OFFLINE_MODE=false
SWO_KP_STORM_THRESHOLD=5.0
SWO_HTTP_TIMEOUT_SECONDS=20
SWO_HTTP_RETRIES=3
SWO_CACHE_TTL_SECONDS=900
SWO_MAX_ANIMATION_FRAMES=600
SWO_DEFAULT_ANIMATION_FPS=24

# Optional. NASA DONKI is not used in the default user interface.
SWO_NASA_ENABLED=false
SWO_NASA_API_KEY=
